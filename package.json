{
  "name": "github-profilestats-rpg",
  "version": "1.0.0",
  "description": "An RPG-style GitHub profile stats journey generator.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "build:action": "ncc build src/action/index.ts -o dist --minify --source-map",
    "check:action": "npm run build:action && git diff --exit-code -- dist",
    "start": "tsx src/cli.ts",
    "update": "tsx src/update.ts",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run build && npm run lint && npm run test",
    "check:ci": "npm run check && npm run check:action && npm run test:visual"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.11",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.8.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
